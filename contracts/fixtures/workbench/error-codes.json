{
  "schema_version": 1,
  "description": "Q-R0 HTTP / business error code matrix (v1 + v2)",
  "matrix": [
    { "http": 401, "code": "auth.required", "retryable": false },
    { "http": 403, "code": "workspace.forbidden", "retryable": false },
    { "http": 404, "code": "resource.not_found", "retryable": false },
    { "http": 409, "code": "revision.conflict", "retryable": true },
    { "http": 409, "code": "request_id.conflict", "retryable": false },
    { "http": 409, "code": "reference.stale", "retryable": true },
    { "http": 413, "code": "upload.too_large", "retryable": false },
    { "http": 415, "code": "document.unsupported_media", "retryable": false },
    { "http": 422, "code": "model.unsupported_input", "retryable": false },
    { "http": 422, "code": "model.unavailable", "retryable": false },
    { "http": 422, "code": "document.unsupported_format", "retryable": false },
    { "http": 422, "code": "publication.gate_failed", "retryable": false },
    { "http": 429, "code": "rate_limited", "retryable": true },
    { "http": 503, "code": "runtime.unavailable", "retryable": true },
