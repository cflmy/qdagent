{
  "schema_version": 1,
  "description": "Q-R0 actual HTTP route → unique business function inventory",
  "http_entry": "serve.mq.md",
  "facade": "lib/api.mq.md",
  "routes": [
    {
      "method": "POST",
      "path": "/api/app/documents/read",
      "api": "api.app_documents_read",
      "impl": "workbench.documents_read",
      "class": "read",
      "authority": "KEEP",
      "notes": "Must pass revision/generation/node_id; reject unknown workspace"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/preview",
      "api": "api.app_resources_preview",
      "impl": "workbench.resources_preview",
      "class": "read",
      "authority": "KEEP",
      "notes": "Unified read-only preview; adapts to documents_read/resources_view; locator page/line"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/blob",
      "api": "api.app_resources_blob",
      "impl": "workbench.resources_blob",
      "class": "read",
      "authority": "KEEP",
      "notes": "Authorized workspace blob for PDF.js / ImagePreview; extract/OCR independent"
    },
    {
      "method": "GET",
      "path": "/api/app/resources/{id}/content",
      "api": "api.app_resources_content",
      "impl": "workbench.resources_content",
      "class": "read",
      "authority": "KEEP",
      "notes": "Authorized content/Range download; rejects remote URLs; revision/digest check"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/read",
      "api": "api.app_resources_read",
      "impl": "workbench.resources_read",
      "class": "read",
      "authority": "KEEP",
      "notes": "Line/cell range + max_bytes + next_cursor; PDF/image extract unavailable (F16)"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/resolve",
      "api": "api.app_resources_resolve",
      "impl": "workbench.resources_resolve",
      "class": "read",
      "authority": "KEEP",
      "notes": "path/slug/resource_id → ResourceRefV1; version mismatch never silent-fallback"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/list",
      "api": "api.app_resources_list",
      "impl": "workbench.resources_list",
      "class": "read",
      "authority": "KEEP",
      "notes": "ResourceRef list with cursor; files and/or notes"
    },
    {
      "method": "POST",
      "path": "/api/app/resources/verify_attachments",
      "api": "api.app_resources_verify_attachments",
      "impl": "workbench.resources_verify_attachments",
      "class": "read",
      "authority": "KEEP",
      "notes": "ContextAttachment pin verify; stale keeps frozen digest (no silent refresh)"
    },
    {
      "method": "POST",
      "path": "/api/app/citations/resolve",
      "api": "api.app_citations_resolve",
      "impl": "workbench.citations_resolve",
      "class": "read",
      "authority": "KEEP",
      "notes": "Inject authorized project into locator; never trust client project_id alone"
    },
    {
      "method": "POST",
      "path": "/api/app/uploads/create",
      "api": "api.app_uploads_create",
      "impl": "workbench.uploads_create",
      "class": "short",
      "authority": "MERGE",
      "notes": "Server-generated path; request_id is index only; prefer uploads.create_upload semantics"
    },
    {
      "method": "POST",
      "path": "/api/app/imports/start",
      "api": "api.app_imports_start",
      "impl": "workbench.imports_start",
      "class": "short",
      "authority": "MERGE",
      "notes": "Use eng_imp draft path; stage ImportJob"
    },
    {
      "method": "POST",
      "path": "/api/app/imports/get",
      "api": "api.app_imports_get",
      "impl": "workbench.imports_get",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "POST",
      "path": "/api/app/imports/publish",
      "api": "api.app_imports_publish",
      "impl": "workbench.imports_publish → knowledge/publication.publish",
      "class": "short",
      "authority": "REFACTOR",
      "notes": "Must create manifest/CURRENT; DB status is projection only"
    },
    {
      "method": "POST",
      "path": "/api/app/turns/cancel",
      "api": "api.app_turns_cancel",
      "impl": "turns.cancel (execution/turns.mq.md)",
      "class": "control",
      "authority": "MERGE",
      "notes": "CAS + /_runtime bridge; unknown turn → 404; no placeholder insert"
    },
    {
      "method": "POST",
      "path": "/api/app/turns/recover",
      "api": "api.app_turns_recover",
      "impl": "workbench.turns_recover",
      "class": "control",
      "authority": "KEEP",
      "notes": "reconnect=events_only; continue=new attempt under CAS; no silent tool replay"
    },
    {
      "method": "GET",
      "path": "/api/app/tools",
      "api": "api.app_tools",
      "impl": "workbench.tools_catalog",
      "class": "read",
      "authority": "KEEP",
      "notes": "Authorized tool inventory; never includes credentials"
    },
    {
      "method": "POST",
      "path": "/api/app/response_preferences",
      "api": "api.app_response_preferences",
      "impl": "workbench.response_preferences_put",
      "class": "control",
      "authority": "KEEP",
      "notes": "detail/scope with expected_revision CAS; turn override > prefs > default"
    },
    {
      "method": "POST",
      "path": "/api/app/profile/get",
      "api": "api.app_profile_get",
      "impl": "workbench.profile_items_get_one",
      "class": "read",
      "authority": "KEEP",
      "notes": "Single profile item for ResourcePreview"
    },
    {
      "method": "GET",
      "path": "/api/app/turns/{id}",
      "api": "api.app_turns_get",
      "impl": "turns.get",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "GET",
      "path": "/api/app/turns/{id}/events",
      "api": "api.app_turns_events",
      "impl": "turns.events",
      "class": "control",
      "authority": "KEEP",
      "notes": "Last-Event-ID / after_seq replay; does not re-run model"
    },
    {
      "method": "GET",
      "path": "/api/app/workspaces",
      "api": "api.app_workspaces",
      "impl": "workbench.workspaces_list",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "GET",
      "path": "/api/app/models",
      "api": "api.app_models",
      "impl": "registry / workbench",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "GET",
      "path": "/api/app/providers",
      "api": "api.app_providers",
      "impl": "workbench.providers",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "POST",
      "path": "/api/app/usage/query",
      "api": "api.app_usage_query",
      "impl": "workbench.usage_query",
      "class": "read",
      "authority": "KEEP"
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "api": "api.v1_chat_completions",
      "impl": "gateway/openai.chat",
      "class": "execute",
      "authority": "KEEP",
      "notes": "sse-live; disconnect ≠ cancel; resume via turn_id + events"
    }
  ],
  "duplicate_modules": [
    {
      "name": "uploads",
      "paths": ["lib/workbench.uploads_create", "lib/uploads.create_upload"],
      "decision": "HTTP uses workbench; align workbench to uploads server-path semantics"
    },
    {
      "name": "turns_cancel",
      "paths": ["lib/workbench.turns_cancel", "execution/turns.cancel"],
      "decision": "execution/turns is authority; workbench facade only"
    },
    {
      "name": "documents_read",
      "paths": ["lib/workbench.documents_read", "lib/workspace"],
      "decision": "HTTP uses workbench; workspace helpers must not be tested as HTTP evidence"
    }
  ],
  "invariants": [
    "Each user operation maps to exactly one business function",
    "Negative tests must hit the HTTP authority path, not a sibling module",
    "Facade may adapt protocol but must not own a second state machine",
    "Every route declares class: execute|short|read|control"
  ]
}
