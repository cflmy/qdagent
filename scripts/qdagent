#!/usr/bin/env bash
# qdagent 2.0 product CLI — Engineering Knowledge Agent surfaces.
# Delegates to Marqdo .mq.md modules (code-as-documentation).
# Requires Marqdo CLI ≥ 1.4.4 + Ext pack ≥ 1.4.4 (soft LLM transport + EFI).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=marqdo-env.sh
source "$ROOT/scripts/marqdo-env.sh"
qdagent_resolve_marqdo

export QDAGENT_DATA="${QDAGENT_DATA:-$ROOT/data}"
export QDAGENT_ROOT="${QDAGENT_ROOT:-$ROOT}"
export MARQDO_FS_ROOT="${MARQDO_FS_ROOT:-$ROOT}"
cd "$ROOT"

cmd="${1:-}"
shift || true

case "$cmd" in
  preflight)
    export QDAGENT_TASK="${*:-给 OpenAI /v1 网关增加工程预检再调上游}"
    exec marqdo run cli/求道-预检.mq.md
    ;;
  build)
    export QDAGENT_TASK="${*:-给 OpenAI /v1 网关增加工程预检再调上游}"
    exec marqdo run cli/求道-构建.mq.md
    ;;
  ask)
    export QDAGENT_TASK="${*:-求道与普通 Coding Agent 的差别是什么？}"
    exec marqdo run cli/求道-询问-工程.mq.md
    ;;
  verify)
    exec marqdo run cli/求道-验证.mq.md
    ;;
  learn)
    export QDAGENT_TASK="${QDAGENT_TASK:-$*}"
    exec marqdo run cli/求道-学习.mq.md
    ;;
  candidates|list-candidates)
    export QDAGENT_PROMOTE_ACTION="list"
    export QDAGENT_STATUS="${QDAGENT_STATUS:-}"
    exec marqdo run cli/求道-晋升.mq.md
    ;;
  promote)
    export QDAGENT_PROMOTE_ACTION="promote"
    export QDAGENT_CANDIDATE="${1:-}"
    export QDAGENT_KIND="${QDAGENT_KIND:-decision}"
    exec marqdo run cli/求道-晋升.mq.md
    ;;
  reject)
    export QDAGENT_PROMOTE_ACTION="reject"
    export QDAGENT_CANDIDATE="${1:-}"
    export QDAGENT_REASON="${*:2}"
    export QDAGENT_REASON="${QDAGENT_REASON:-rejected}"
    exec marqdo run cli/求道-晋升.mq.md
    ;;
  metrics|kpi)
    exec marqdo run cli/求道-指标.mq.md
    ;;
  labels|debt)
    # M8 debt ratchet (local mirror of the CI gate) + M9 pending list.
    # Exit code propagates from marqdo labels --fail-on-increase.
    exec marqdo run cli/求道-债务.mq.md
    ;;
  find|know)
    export QDAGENT_QUERY="${*:-authentication}"
    marqdo find "$QDAGENT_QUERY" . -o .marqdo --json
    ;;
  reuse)
    export QDAGENT_TASK="${*:-}"
    marqdo reuse --preflight --json "$QDAGENT_TASK" . -o .marqdo
    ;;
  impact)
    # Thin wrap: marqdo impact [PATH]... --json
    marqdo impact "$@" --root . -o .marqdo --json
    ;;
  conflicts)
    marqdo conflicts . -o .marqdo --json
    ;;
  stale)
    marqdo stale . -o .marqdo --json
    ;;
  duplicate|duplicates)
    marqdo duplicate . -o .marqdo --json
    ;;
  knowledge|compile)
    exec marqdo knowledge . -o .marqdo
    ;;
  import)
    # TXT/Markdown → document.extract → drafts → optional publish
    export QDAGENT_IMPORT_PATH="${1:-}"
    export QDAGENT_KB_ROOT="${QDAGENT_KB_ROOT:-}"
    export QDAGENT_IMPORT_PUBLISH="${QDAGENT_IMPORT_PUBLISH:-0}"
    if [[ -z "${QDAGENT_IMPORT_PATH}" ]]; then
      echo "usage: qdagent import <path.txt|.md>   # set QDAGENT_IMPORT_PUBLISH=1 to publish" >&2
      exit 2
    fi
    exec marqdo run cli/求道-导入.mq.md
    ;;
  up|serve|web)
    # Always prefer scripts/qdagent-up.sh: build SPA → restart serve → verify
    # hashed assets. serve.mq.md boot-reads public/app/index.html once; skipping
    # rebuild+restart after a Vite hash change yields a blank page.
    # SKIP_BUILD=1 up  → restart only; FOREGROUND=1 up → exec serve in fg.
    exec "$ROOT/scripts/qdagent-up.sh"
    ;;
  mcp)
    exec "$ROOT/scripts/mq.sh" run cli/求道-mcp.mq.md
    ;;
  ""|-h|--help|help)
    cat <<'EOF'
qdagent — Executable Engineering Knowledge Agent (CLI ≥2.1.2 · Ext ≥2.1.2)

Usage:
  qdagent preflight [task]
  qdagent build [task]
  qdagent ask [task]
  qdagent verify
  qdagent learn
  qdagent candidates
  qdagent promote <slug>
  qdagent reject <slug> [reason]
  qdagent metrics
  qdagent labels|debt        # engineering debt ratchet + pending list (M8/M9)
  qdagent find|know [query]
  qdagent reuse [task]
  qdagent impact [path...]
  qdagent conflicts
  qdagent stale
  qdagent duplicate
  qdagent knowledge   # marqdo knowledge compile
  qdagent import <path>  # TXT/MD → drafts (QDAGENT_IMPORT_PUBLISH=1 to publish)
  qdagent up|serve|web   # build SPA → restart serve → verify assets (blank-page safe)
  qdagent mcp

Dogfood example:
  qdagent knowledge
  qdagent preflight "给 OpenAI /v1 网关增加工程预检再调上游"
  qdagent build "给 OpenAI /v1 网关增加工程预检再调上游"
  qdagent verify
  qdagent candidates
  qdagent promote cand-YYYYMMDD-HHMMSS
  qdagent learn
  qdagent labels
  qdagent impact lib/api.mq.md
  qdagent conflicts
  qdagent import corpus/note.txt
EOF
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "try: qdagent help" >&2
    exit 2
    ;;
esac
