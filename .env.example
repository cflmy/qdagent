# LLM credentials are configured in the app: Settings → 模型 (providers/credentials).
# Do NOT put OPENAI_* / MARQDO_LLM_* here — ensure_llm reads only the registry.

# Local: scripts/mq.sh prefers ~/work/marqdo/ext when present, else ~/.marqdo/ext
# Docker compose sets MARQDO_EXT=/root/.marqdo/ext
# Require Marqdo CLI ≥ 2.1.3 · Ext ≥ 2.1.3

QDAGENT_HOST=0.0.0.0
QDAGENT_PORT=7431
QDAGENT_DATA=data

# Product gateway auth (not upstream LLM key). Default qdagent-local.
# QDAGENT_API_KEY=qdagent-local
