# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Secrets / local env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Runtime / logs (data/ also ignores via data/.gitignore)
*.log
*.pid
*.db
*.db-shm
*.db-wal

# Local scratch
_t.mq.md
_s.mq.md
*.ck

# Local knowledge vault (nested git under data/; do not push user notes)
/data/kb/
/data/runs/
/data/sessions/
/data/skills/
/data/tmp/
/data/workbooks/
/data/candidates/
/data/amortization.json

# EKC generated projection
.marqdo/

# Editor agent local state (keep committed rules under .cursor/rules/)
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Reference archives (large binary zip, not source)
Reference/

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
public/app/

# Local build helpers (zig cc wrappers, caches) — machine-specific
.tools/

# marqdo fs.make_temp leftovers under tests/
tests/**/mqtmp-*
tests/workbench/data/
drafts/
data/tmp-*
/data/uploads/
evidence/
frontend/test-results/
frontend/playwright-report/

# Local publish/test artifacts under knowledge/
knowledge/published-gen-*.mq.md
data/*.err

# Archived pre-2.7.1 implementation (kept locally, never versioned)
old/

# Container secrets and SQLite runtime
.secrets/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Runtime task workspaces / dialogue caches
/data/workspaces/
/data/dialogue/
/data/qdagent/

# Accidental duplicate trees (space and quote in name)
# 只是最后一道防线：deploy/check-layout.sh 会在构建开始时直接失败，
# 正确的做法是修正生成该路径的未加引号脚本，而不是依赖忽略规则。
/ext + "/
/pages/ext + "/
/.* + "/

# Site runtime state written by marqdo serve (dialogue cache, turn counters)
/pages/data/*
!/pages/data/.gitkeep

# Modern workspace artifacts
/test-results/
/server/qdagent
/frontend/tsconfig.tsbuildinfo
